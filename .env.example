# Supabase Configuration
# Dapatkan dari Supabase Dashboard -> Project Settings -> API Keys
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Server-only secret key (JANGAN gunakan di browser / client components)
SUPABASE_SECRET_KEY="sb_secret_your_secret_key_here"

# Admin Dashboard Credentials
ADMIN_PASSWORD="GantiDenganPasswordAdminKuat123!"
ADMIN_SESSION_SECRET="64_karakter_hex_acak_untuk_menandatangani_cookie_sesi"
